#!/bin/sh
# keel gate check — secrets in this repository.
#
# Prints one keel.gate/1 Check on stdout.
#
#   pass    — gitleaks scanned and found nothing
#   fail    — a credential is committed, or is sitting in uncommitted work
#   blocked — gitleaks is not installed, so nothing was scanned
#
# Why this check exists here specifically: `keel run` writes build.txt,
# test.txt, lint.txt and driver-stderr.txt into .keel/runs/<id>/evidence/, and
# .keel/runs/** is meant to be committed -- that is the audit trail. So any
# secret a build, test or driver command prints becomes a committed artefact.
# Faithfully recording what your commands printed is the feature; this is the
# check that stops it becoming the leak. See SECURITY.md.
#
# Two scans, because neither alone is enough:
#   git    — every commit. Catches a credential added and later deleted, which
#            a working-tree scan cannot see.
#   stdin  — the uncommitted diff. `keel run --no-driver` gates work that is not
#            committed yet, and history knows nothing about it.
#
# Not `gitleaks dir`: it walks the filesystem without consulting .gitignore, so
# on this repository it scans target/ -- 947MB and 30 seconds, versus 282ms for
# the whole git history. A check that slow is a check people stop running.
#
# Findings report the rule and the location. The matched secret is never
# printed: this output is written to .keel/runs/<id>/gates/G2.json and
# committed, and a check that copies a credential into the audit trail to warn
# you about it has done more harm than the leak.
set -u

if ! command -v gitleaks >/dev/null 2>&1; then
    printf '%s\n' '{"id":"secrets","verdict":"blocked","detail":"gitleaks is not installed — `brew install gitleaks`, or see https://github.com/gitleaks/gitleaks. Nothing was scanned for credentials."}'
    exit 0
fi

hist=$(mktemp) || exit 1
work=$(mktemp) || exit 1
trap 'rm -f "$hist" "$work"' EXIT

# --exit-code 0 so a finding is not a shell failure; the JSON is the verdict.
gitleaks git --report-format json --report-path "$hist" --exit-code 0 >/dev/null 2>&1
git diff HEAD 2>/dev/null \
  | gitleaks stdin --report-format json --report-path "$work" --exit-code 0 >/dev/null 2>&1

HIST="$hist" WORK="$work" python3 -c '
import json, os, sys

def load(path):
    try:
        with open(path) as fh:
            return json.load(fh) or []
    except Exception:
        return []

hist = load(os.environ["HIST"])
work = load(os.environ["WORK"])
total = len(hist) + len(work)

if not total:
    print(json.dumps({
        "id": "secrets",
        "verdict": "pass",
        "detail": "gitleaks found no credentials in the history or the working tree.",
    }))
    sys.exit(0)

# Rule id and location only -- never the matched value.
def where(f, uncommitted=False):
    rule = f.get("RuleID", "?")
    if uncommitted:
        return "%s in uncommitted changes (line %s)" % (rule, f.get("StartLine", "?"))
    path = f.get("File") or "?"
    commit = (f.get("Commit") or "")[:8]
    at = " @%s" % commit if commit else ""
    return "%s in %s:%s%s" % (rule, path, f.get("StartLine", "?"), at)

hits = [where(f) for f in hist[:3]] + [where(f, True) for f in work[:3]]
print(json.dumps({
    "id": "secrets",
    "verdict": "fail",
    "expected": "no credentials in the repository",
    "actual": "%d finding(s): %s" % (total, "; ".join(hits[:4])),
    "detail": "run `gitleaks git` and `git diff HEAD | gitleaks stdin` for the full report. Rotate anything real before removing it -- a committed secret is compromised even after the commit is rewritten.",
}))
'
