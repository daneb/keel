#!/bin/sh
# keel driver — Claude Code, headless.
#
# The contract (keel.drivertask/1 in, keel.driverresult/1 out) is all keel
# requires. Drivers stay thin on purpose: everything below is plumbing between
# keel's JSON and one `claude -p` invocation. If you find yourself adding
# behaviour here, it probably belongs in keel or in the agent, not in the seam.
#
# Requires: claude on PATH, python3 (for JSON), git.
set -u

emit() {
  # $1 status, $2 detail, $3 files (JSON array)
  printf '{"schema":"keel.driverresult/1","status":"%s","files_changed":%s,"detail":"%s"}\n' \
    "$1" "${3:-[]}" "$(printf '%s' "$2" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\n')"
}

task=$(cat)

if ! command -v claude >/dev/null 2>&1; then
  emit blocked "claude is not on PATH"
  exit 0
fi
if ! command -v python3 >/dev/null 2>&1; then
  emit blocked "python3 is not on PATH (needed to read the task JSON)"
  exit 0
fi

prompt=$(printf '%s' "$task" | python3 -c '
import json, sys
t = json.load(sys.stdin)
scope = ", ".join(t.get("scope", []))
budget = t.get("budget_lines")
print(t["prompt"])
print()
print("Stay strictly inside this scope: " + scope)
if budget:
    print("Keep the whole change under %d lines." % budget)
print("Make the changes directly in the working tree. Do not commit.")
') || { emit blocked "could not read the task JSON"; exit 0; }

before=$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')

# --print runs headless; keel owns the gating, so the agent needs no approval UI.
if ! out=$(printf '%s' "$prompt" | claude --print 2>&1); then
  emit blocked "claude exited non-zero: $(printf '%s' "$out" | tail -c 400)"
  exit 0
fi

files=$(git status --porcelain 2>/dev/null \
  | awk '{ $1=""; sub(/^ /, ""); print }' \
  | python3 -c 'import json,sys; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))')

after=$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')
if [ "$before" = "$after" ] && [ "$after" = "0" ]; then
  emit failed "claude ran but changed nothing" "$files"
  exit 0
fi

emit ok "claude completed" "$files"
