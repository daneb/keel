+++/// Documentation and plain prose: files that carry no behaviour a test could
+++/// exercise. Deliberately narrow — config files (`.toml`, `.yaml`, `.json`)
+++/// are *not* docs and stay counted as substantive.
+++fn is_docs(path: &str) -> bool {
+++    let lower = path.to_ascii_lowercase();
+++    lower.ends_with(".md")
+++        || lower.ends_with(".markdown")
+++        || lower.ends_with(".mdx")
+++        || lower.ends_with(".txt")
+++        || lower.ends_with(".rst")
+++        || lower.ends_with(".adoc")
+++}
