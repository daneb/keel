+++++-    let is_test = |p: &str| crate::map::rank::is_test(p);
++++++///
++++++/// "Code" here means a testable source file. Two files are *not* code for this
++++++/// purpose:
++++++///
++++++/// * **Documentation** — prose carries no behaviour an oracle could exercise,
++++++///   so a change made only of docs has nothing to test and must not trip a
++++++///   heuristic whose whole question is "was this code tested?".
++++++/// * **A source file that is itself a test** — recognised either by path
++++++///   convention (`crate::map::rank::is_test`) or, for languages like Rust
++++++///   whose tests live inline, by the change adding a `#[test]` or
++++++///   `#[cfg(test)]` attribute. A file that gains inline tests is tested by
++++++///   definition; demanding a *separate* test file would block nearly every
++++++///   legitimate Rust change, keel's own included.
++++++///
++++++/// `patch` is the unified diff already read for `test-invalidation`; when it is
++++++/// absent (it could not be read) inline detection is simply skipped, which is
++++++/// the pre-existing, more conservative behaviour.
