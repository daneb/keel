++++    #[test]
++++    fn docs_only_change_does_not_block_test_movement() {
++++        // A change made only of prose has no code an oracle could exercise, so
++++        // the heuristic whose question is "was this code tested?" must pass.
++++        let d = diff::Diff {
++++            base: "HEAD".into(),
++++            files: vec![
++++                diff::FileChange { path: "README.md".into(), added: 30, removed: 10, binary: false },
++++                diff::FileChange { path: "GETTING-STARTED.md".into(), added: 12, removed: 0, binary: false },
++++                diff::FileChange { path: "docs/design.txt".into(), added: 5, removed: 0, binary: false },
++++            ],
++++            added: 47,
++++            removed: 10,
++++        };
++++        assert_eq!(test_movement(&Config::default(), &d, None).verdict, super::super::Verdict::Pass);
++++    }
++++
++++    #[test]
++++    fn docs_do_not_mask_a_missing_test() {
++++        // Docs alongside real code must not launder the missing test: the code
++++        // still counts, so the verdict is still blocked.
++++        let d = diff::Diff {
++++            base: "HEAD".into(),
++++            files: vec![
++++                diff::FileChange { path: "src/api.rs".into(), added: 40, removed: 0, binary: false },
++++                diff::FileChange { path: "README.md".into(), added: 20, removed: 0, binary: false },
++++            ],
++++            added: 60,
++++            removed: 0,
++++        };
++++        assert_eq!(test_movement(&Config::default(), &d, None).verdict, super::super::Verdict::Blocked);
++++    }
++++
++++    #[test]
++++    fn inline_rust_tests_count_as_test_movement() {
++++        // A source file that gains inline `#[test]` functions is tested by
++++        // definition; the dominant Rust convention has no separate test file to
++++        // move, and demanding one would block nearly every legitimate change.
++++        let d = diff::Diff {
++++            base: "HEAD".into(),
++++            files: vec![diff::FileChange {
++++                path: "src/gate/g25.rs".into(),
++++                added: 30,
++++                removed: 0,
++++                binary: false,
++++            }],
++++            added: 30,
++++            removed: 0,
++++        };
++++        let patch = "+++ b/src/gate/g25.rs\n+    #[test]\n+    fn a_new_test() {}\n";
++++        assert_eq!(
++++            test_movement(&Config::default(), &d, Some(patch)).verdict,
++++            super::super::Verdict::Pass
++++        );
++++        // Without the patch, inline detection is skipped and the conservative
++++        // "code with no test file" verdict still blocks.
++++        assert_eq!(
++++            test_movement(&Config::default(), &d, None).verdict,
++++            super::super::Verdict::Blocked
++++        );
+++     }
+++ }
