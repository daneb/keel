+/// Files whose *added* lines introduce an inline test — a `#[test]` or
+/// `#[cfg(test)]` attribute. Parsed from the same unified diff
+/// `test-invalidation` reads, so no extra git call is made.
+fn files_adding_inline_tests(patch: Option<&str>) -> std::collections::BTreeSet<String> {
+    let mut out = std::collections::BTreeSet::new();
+    let Some(patch) = patch else { return out };
+    let mut current = String::new();
+    for line in patch.lines() {
+        if let Some(rest) = line.strip_prefix("+++ b/") {
+            current = rest.trim().to_string();
+            continue;
+        }
+        let Some(added) = line.strip_prefix('+') else { continue };
+        if added.starts_with("++") {
+            continue;
+        }
+        let trimmed = added.trim_start();
+        let is_test_attr = trimmed.starts_with("#[test]")
+            || trimmed.starts_with("#[cfg(test)]")
+            || trimmed.starts_with("#[tokio::test");
+        if is_test_attr && !current.is_empty() {
+            out.insert(current.clone());
+        }
+    }
+    out
