+/// The `approval` object for a spec waiting at an approval stage, or `None`
+/// outside one. `standing` is never `current`: a current approval has already
+/// moved the spec past this stage, so it cannot be the one `next` reports.
+fn approval_json(slug: &str, stage: Stage, pos: &Position) -> Option<serde_json::Value> {
+    let (stage_key, standing) = match stage {
+        Stage::SpecApproval => ("spec", &pos.spec_approval),
+        Stage::PlanApproval => ("plan", &pos.plan_approval),
+        Stage::MergeApproval => ("merge", &pos.merge_approval),
+        _ => return None,
+    };
+
+    let (standing_key, by, note): (&str, Option<String>, Option<String>) = match standing {
+        Standing::Absent => ("absent", None, None),
+        Standing::Rejected { by, note } => ("rejected", Some(by.clone()), note.clone()),
+        Standing::Superseded { .. } => ("superseded", None, None),
+        Standing::Current { .. } => {
+            unreachable!("a current approval has already advanced past its stage")
+        }
+    };
+
+    let recheck = matches!(standing_key, "rejected" | "superseded").then(|| match stage_key {
+        "spec" => format!("keel gate g0 {slug}"),
+        "plan" => format!("keel gate g1 {slug}"),
+        _ => format!("keel run {slug}"),
+    });
+
+    Some(serde_json::json!({
+        "stage": stage_key,
+        "standing": standing_key,
+        "by": by,
+        "note": note,
+        "recheck": recheck,
+    }))
+}
