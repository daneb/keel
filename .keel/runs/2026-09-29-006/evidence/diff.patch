++++
++++    let v = json(&r, &["next", "--json"]);
++++    assert_eq!(v["specs"][0]["stage"], "spec_approval");
++++    assert_eq!(v["specs"][0]["approval"]["standing"], "rejected");
++++    assert!(v["specs"][0]["approval"]["by"].as_str().is_some_and(|s| !s.is_empty()));
