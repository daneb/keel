++++        Stage::MergeApproval => ("merge", format!("keel run {slug}")),
++++        _ => return None,
++++    };
++++    Some(match standing {
++++        Standing::Absent => json!({ "stage": name, "standing": "absent" }),
++++        Standing::Rejected { by, note } => json!({
++++            "stage": name,
++++            "standing": "rejected",
++++            "by": by,
++++            "note": note,
++++            "recheck": recheck,
