+/// AC-1 — every approval stage carries an `approval` object naming which
+/// stage it is and that no decision has been recorded yet.
+#[test]
+fn next_json_reports_approval_standing() {
+    let r = Repo::bare("json-appr-standing");
+    r.write_spec();
+    r.ok(&["gate", "g0", "demo"]);
+    let v = json(&r, &["next", "--json"]);
+    assert_eq!(v["specs"][0]["stage"], "spec_approval");
+    assert_eq!(v["specs"][0]["approval"]["stage"], "spec");
+    assert_eq!(v["specs"][0]["approval"]["standing"], "absent");
+
+    r.ok(&["approve", "demo", "--stage", "spec"]);
+    r.ok(&["plan", "demo"]);
+    r.set_rollback("git revert the merge");
+    r.write_tasks();
+    r.ok(&["gate", "g1", "demo"]);
+    let v = json(&r, &["next", "--json"]);
+    assert_eq!(v["specs"][0]["stage"], "plan_approval");
+    assert_eq!(v["specs"][0]["approval"]["stage"], "plan");
+    assert_eq!(v["specs"][0]["approval"]["standing"], "absent");
+
+    r.ok(&["approve", "demo", "--stage", "plan"]);
+    r.install_driver("noop", &noop_driver());
+    r.run(&["run", "demo"]);
+    let v = json(&r, &["next", "--json"]);
+    assert_eq!(v["specs"][0]["stage"], "merge_approval");
+    assert_eq!(v["specs"][0]["approval"]["stage"], "merge");
+    assert_eq!(v["specs"][0]["approval"]["standing"], "absent");
+}
+
+/// AC-2 — a rejection names who rejected it and why, and a note-less
+/// rejection reports `null` rather than an empty string.
+#[test]
+fn next_json_reports_who_rejected_and_why() {
+    let r = Repo::bare("json-appr-rejected");
+    r.write_spec();
+    r.ok(&["gate", "g0", "demo"]);
+    r.ok(&["approve", "demo", "--stage", "spec", "--reject", "--note", "too vague"]);
+    let v = json(&r, &["next", "--json"]);
+    assert_eq!(v["specs"][0]["approval"]["standing"], "rejected");
+    assert_eq!(v["specs"][0]["approval"]["by"], "Test Person");
+    assert_eq!(v["specs"][0]["approval"]["note"], "too vague");
+
+    r.ok(&["approve", "demo", "--stage", "spec", "--reject"]);
+    let v = json(&r, &["next", "--json"]);
+    assert!(v["specs"][0]["approval"]["note"].is_null());
+}
+
+/// AC-3 — a rejected or stale approval names the command that clears it.
+#[test]
+fn next_json_names_the_recheck_command() {
+    let r = Repo::bare("json-appr-recheck");
+    r.write_spec();
+    r.ok(&["gate", "g0", "demo"]);
+    r.ok(&["approve", "demo", "--stage", "spec", "--reject"]);
+    let v = json(&r, &["next", "--json"]);
+    assert_eq!(v["specs"][0]["approval"]["recheck"], "keel gate g0 demo");
+
+    // Superseded: approved, then the artefact changes underneath it.
+    r.ok(&["approve", "demo", "--stage", "spec"]);
+    let p = ".keel/specs/demo/spec.md";
+    r.write(p, &r.read(p).replace("HTTP 429", "HTTP 503"));
+    let v = json(&r, &["next", "--json"]);
+    assert_eq!(v["specs"][0]["approval"]["standing"], "superseded");
+    assert_eq!(v["specs"][0]["approval"]["recheck"], "keel gate g0 demo");
+
+    let r = Repo::ready("json-appr-recheck-plan");
+    r.ok(&["approve", "demo", "--stage", "plan", "--reject"]);
+    let v = json(&r, &["next", "--json"]);
+    assert_eq!(v["specs"][0]["approval"]["recheck"], "keel gate g1 demo");
+
+    r.ok(&["approve", "demo", "--stage", "plan"]);
+    r.install_driver("noop", &noop_driver());
+    r.run(&["run", "demo"]);
+    r.ok(&["approve", "demo", "--stage", "merge", "--reject"]);
+    let v = json(&r, &["next", "--json"]);
+    assert_eq!(v["specs"][0]["approval"]["recheck"], "keel run demo");
+}
+
+/// AC-4 — outside an approval stage, the field is absent rather than null.
+#[test]
+fn next_json_omits_approval_outside_approval_stages() {
+    let r = Repo::bare("json-appr-omit");
+    r.write_spec();
+    let v = json(&r, &["next", "--json"]);
+    assert_eq!(v["specs"][0]["stage"], "spec");
+    assert!(v["specs"][0]["approval"].is_null());
+
+    r.ok(&["gate", "g0", "demo"]);
+    r.ok(&["approve", "demo", "--stage", "spec"]);
+    let v = json(&r, &["next", "--json"]);
+    assert_eq!(v["specs"][0]["stage"], "plan");
+    assert!(v["specs"][0]["approval"].is_null());
+
+    r.ok(&["plan", "demo"]);
+    r.set_rollback("git revert the merge");
+    r.write_tasks();
+    r.ok(&["gate", "g1", "demo"]);
+    r.ok(&["approve", "demo", "--stage", "plan"]);
+    let v = json(&r, &["next", "--json"]);
+    assert_eq!(v["specs"][0]["stage"], "run");
+    assert!(v["specs"][0]["approval"].is_null());
+
+    r.install_driver("noop", &noop_driver());
+    r.run(&["run", "demo"]);
+    r.ok(&["approve", "demo", "--stage", "merge"]);
+    let v = json(&r, &["next", "--json"]);
+    assert_eq!(v["specs"][0]["stage"], "complete");
+    assert!(v["specs"][0]["approval"].is_null());
+}
