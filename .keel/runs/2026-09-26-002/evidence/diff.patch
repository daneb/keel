++/// AC-4 — the run's identity is recorded, as the runner's claim.
++#[test]
++fn run_identity_is_recorded_as_a_claim() {
++    let env = [
++        ("GITHUB_REPOSITORY", "daneb/keel-cover-demo"),
++        ("GITHUB_WORKFLOW", "keel runtime"),
++        ("GITHUB_RUN_ID", "12345"),
