{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "keel.posture/1 runtime attestation",
  "description": "Written by the runtime before it starts keel, and named in KEEL_RUNTIME_ATTESTATION. Each property is a claim the runtime makes from outside the sandbox: proven, unproven (cannot vouch either way) or violated.",
  "type": "object",
  "required": ["schema", "runtime", "properties"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "keel.posture/1" },
    "runtime": { "type": "string", "minLength": 1 },
    "image_digest": { "type": "string" },
    "attested_at": { "type": "string", "format": "date-time" },
    "runtime_identity": {
      "description": "Who ran this, as the runtime reports it: a claim, not proof, until signed. Additive to keel.posture/1.",
      "type": "object",
      "required": ["claimed_by"],
      "additionalProperties": { "type": "string" },
      "properties": { "claimed_by": { "type": "string", "minLength": 1 } }
    },
    "properties": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "additionalProperties": false,
        "properties": {
          "status": { "enum": ["proven", "unproven", "violated"] },
          "evidence": { "type": "string" }
        }
      }
    }
  }
}
